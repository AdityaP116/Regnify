# Public Firebase Web config (safe to expose — these are not secrets).
# Leave blank to run in fully-local demo mode.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional. Only needed once Firebase Analytics is wired up.
VITE_FIREBASE_MEASUREMENT_ID=

# Base URL of the FastAPI service.
# For local dev: /api (proxied to :8000 by Vite)
# For production (Vercel): https://regnify.onrender.com/api
VITE_API_BASE_URL=/api
