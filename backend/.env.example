# ─── Firebase Admin SDK ──────────────────────────────────────────────────────
# Option A: individual fields (copy from your Firebase Service Account JSON)
FIREBASE_PROJECT_ID=regnify-48493
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxx@regnify-48493.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option B: path to the downloaded service account JSON (takes precedence)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# ─── Gemini API ──────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ─── App Settings ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
# Set to "true" to skip Firebase credential checks and serve seed data only
DEMO_MODE=false
